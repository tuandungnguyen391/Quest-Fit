# Copy this file to .env and fill in your own cloud Postgres connection string.
# Get one for free from Neon (https://neon.tech), Supabase (https://supabase.com),
# or Railway (https://railway.app). See README.md for step-by-step instructions.

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: change which port the server runs on (defaults to 3000)
# PORT=3000
